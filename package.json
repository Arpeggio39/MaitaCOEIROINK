{
  "name": "openmaita-shell",
  "version": "0.1.1",
  "description": "琵音マイタ専用の COEIROINK API ラッパー OpenMaita（Electron）",
  "main": "src/main/index.js",
  "author": "Arpeggio",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.6.3"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:mac": "electron-builder --mac",
    "dist:mac:dir": "electron-builder --mac --dir",
    "dist:win": "electron-builder --win --x64",
    "dist:win:publish": "electron-builder --win --x64 --publish always",
    "dist:win:dir": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "jp.arpeggio.openmaita",
    "productName": "OpenMaita",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music"
    },
    "dmg": {
      "title": "OpenMaita ${version}",
      "artifactName": "OpenMaita-${version}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "OpenMaita"
    },
    "publish": {
      "provider": "github",
      "owner": "Arpeggio39",
      "repo": "MaitaCOEIROINK",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenMaita",
      "uninstallDisplayName": "OpenMaita",
      "installerLanguages": [
        "ja_JP",
        "en_US"
      ],
      "language": "1041",
      "artifactName": "OpenMaita-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
