{
  "name": "openmaita-shell",
  "version": "1.15.0",
  "description": "COEIROINK で琵音マイタのナレーションを作る Windows アプリ",
  "main": "src/main/index.js",
  "type": "commonjs",
  "author": "Arpeggio",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "iconv-lite": "^0.7.3"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:mac": "electron-builder --mac",
    "dist:mac:dir": "electron-builder --mac --dir",
    "dist:win": "electron-builder --win --x64",
    "dist:win:publish": "electron-builder --win --x64 --publish always",
    "dist:win:dir": "electron-builder --win --x64 --dir",
    "build:native": "node scripts/build-native.cjs",
    "postinstall": "node scripts/copy-video-vendor.cjs"
  },
  "build": {
    "appId": "jp.arpeggio.openmaita",
    "productName": "OpenMaita",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music"
    },
    "dmg": {
      "title": "OpenMaita ${version}",
      "artifactName": "OpenMaita-${version}.${ext}"
    },
    "win": {
      "icon": "bionmaita/icons/302790798.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "OpenMaita"
    },
    "publish": {
      "provider": "github",
      "owner": "Arpeggio39",
      "repo": "MaitaCOEIROINK",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenMaita",
      "uninstallDisplayName": "OpenMaita",
      "installerLanguages": [
        "ja_JP",
        "en_US"
      ],
      "language": "1041",
      "artifactName": "OpenMaita-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg-notices",
        "filter": [
          "LICENSE",
          "ffmpeg*.LICENSE",
          "ffmpeg*.README",
          "README.md"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "pixi.js": "8.22.0",
    "playwright-core": "^1.64.1",
    "untitled-pixi-live2d-engine": "1.4.0"
  }
}
